/**
 * 提示词库的「家族骨架」：同结构的两百多条源片共享一份中文正文，条目只写差异段。
 *
 * 为什么不是一条一份正文：源站 207 条里有 72 条是同一段 showreel 指令换了主题、
 * 40 条是同一段产品片指令换了产品。逐条重写只会得到几十份近义复述——那不算"整理"，
 * 是把重复放大 30 倍。真正有信息量的是两件事：**这一段骨架**（怎么拍）和
 * **这一条差异**（拍什么、有什么特殊约束）。所以骨架写在下面，差异写在种子的 note 里。
 *
 * 家族的划分方式（可复现）：按 `<direction>` 的首句句式聚类——源站首句就是体裁声明
 * （"A 15-second motion design showreel…" / "A 15-second promo for…"），聚类结果落在
 * `data/prompt-motion/family-map.json`。首句独一无二、且结构确实另成一派的 7 条不进家族，
 * 正文写在种子里（`body` 直接给）。
 *
 * 写作纪律（`scripts/check-prompt-library.mts` 会挡）：
 * · 不出现 `##`（索引取正文是到文件尾，混进二级标题会把后半段截断）
 * · 不出现源站技术栈词（Playwright / window.seek / Web Audio / tmix / HTML / three.js）——
 *   抄进来等于教 agent 做我们做不到的事
 * · 保留源站最有价值的部分：贯穿物、三幕结构、动效铁律、**禁止清单**、出片前怎么验
 */
import type { PromptGenre } from "./types.mts";

export type Family = {
  genre: PromptGenre;
  /** 卡片摘要模板，`{t}` 替换成条目的中文主题 */
  lookTpl: string;
  /** 「适合」整族共用——它描述的是体裁的适用场景，不是单条的 */
  fit: string;
  /** 「关键词」整族共用 */
  tags: string[];
  /** `## 提示词` 正文（族内共享） */
  body: string;
};

